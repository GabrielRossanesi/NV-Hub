# ==========================================================================
# Banco de dados — PostgreSQL (Supabase)
# ==========================================================================
# Em Vercel serverless, use a URL do Transaction Pooler (porta 6543) exibida
# em Supabase > Connect. Copie o host exato do painel; ele não pode ser
# deduzido apenas do project ref. Prisma 6 requer pgbouncer=true nesse modo.
# Limite de conexões por instância: ajuste conforme o plano/carga.
# Exemplo: postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:password@localhost:5432/nvhub"

# Prisma Migrate usa conexão direta (IPv6) ou Session Pooler (porta 5432,
# IPv4). Em desenvolvimento local, pode ser igual a DATABASE_URL.
# Obrigatória no schema.prisma; não use Transaction Pooler aqui.
DIRECT_URL="postgresql://postgres:password@localhost:5432/nvhub"

# ==========================================================================
# Better Auth
# ==========================================================================
# Gere uma chave aleatória com: openssl rand -base64 32
BETTER_AUTH_SECRET="some-random-long-secret-key-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# URL pública da aplicação (redirects e links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================================================
# Modo de dados (data-mode) — FAIL-CLOSED
# ==========================================================================
# Padrão é sempre "database". O modo demo só é ativado com opt-in EXPLÍCITO e
# nunca em produção/Vercel.
#   - (não definir)  -> "database" (recomendado)
#   - "sandbox"      -> demo com Zustand/localStorage (apenas fora de produção)
# NEXT_PUBLIC_DATA_MODE="sandbox"

# Timings estruturados do servidor. Em desenvolvimento os logs ficam ativos;
# use 1 temporariamente em Preview para medir Vercel -> Railway.
PERF_LOGGING="0"

# ==========================================================================
# Seed do banco (prisma/seed.ts) — NUNCA em produção
# ==========================================================================
# ⚠️ Se "true", o seed APAGA registros existentes antes de recriar.
#    Nunca defina como true em produção.
# ALLOW_DESTRUCTIVE_SEED="false"

# Senhas iniciais usadas pelo seed (se ausentes, senhas aleatórias são geradas
# e impressas no log do seed). Use apenas em ambientes de desenvolvimento.
# SEED_OPERATOR_PASSWORD=""
# SEED_CLIENT_PASSWORD=""
